@model List<Genrev.Web.App.Customers.Models.AreaOfResponsibilityListItemVM>

<h2>Area of Responsibilities</h2>

<table>
    <tr>
        <td>
            @Html.DevExpress().TextBox(
                s =>
                     {
                    s.Name = "AddAreaOfResponsibility";
                    s.Width = 170;
                }
            ).GetHtml()
        </td>
        <td style="padding-left: 5px;">
            @Html.DevExpress().Button(
                s =>
                     {
                    s.Name = "AddAreaOfResponsibilityButton";
                    s.Text = "Add";
                    s.Width = 75;
                }
            ).GetHtml()
        </td>
    </tr>
</table>

<div class="spacer-10"></div>

@Html.Partial("AreaOfResponsibilitiesGrid", Model)



