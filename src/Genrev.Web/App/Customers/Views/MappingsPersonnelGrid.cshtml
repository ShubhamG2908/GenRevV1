@model List<Genrev.Web.App.Customers.Models.MappingPersonnelListItemVM>

@Html.DevExpress().GridView(
    s => {

        s.Name = "CustomerMappingsPersonnelGrid";
        s.KeyFieldName = "ID";
        s.CallbackRouteValues = new { Controller = "Customers", Action = "CustomerMappingsPersonnelGridCallback" };
        s.SettingsBehavior.AllowFocusedRow = true;
        s.SettingsBehavior.AllowSelectByRowClick = true;
        s.SettingsBehavior.AllowSelectSingleRowOnly = true;
        s.SettingsLoadingPanel.Mode = GridViewLoadingPanelMode.Disabled;

        s.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;

        s.Width = 300;
        
        var col = s.Columns.Add("colFirstName");
        col.Caption = "First Name";
        col.FieldName = "FirstName";

        col = s.Columns.Add("colLastName");
        col.Caption = "Last Name";
        col.FieldName = "LastName";
    }
).Bind(Model).GetHtml()