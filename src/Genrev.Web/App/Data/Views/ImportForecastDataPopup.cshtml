@model Genrev.Web.App.Customers.Models.EditAccountTypeVM

<h3>Import Forecast Data</h3>

@using (Html.BeginForm())
{
    <div class="dg-row" style="margin-bottom:30px;">
        <div class="dg-col-12">
            @Html.DevExpress().UploadControl(
             s =>
                  {
                 s.Name = "uploadForecastData";
                 s.ShowProgressPanel = false;
                 s.UploadMode = UploadControlUploadMode.Auto;
                 s.AutoStartUpload = true;
                 s.Width = Unit.Percentage(80);
                 s.CallbackRouteValues = new { Controller = "Data", Action = "UploadForecastData" };
                 s.ValidationSettings.Assign(Genrev.Web.App.Data.DataUploadValidation.ForecastSettings);
             }
         ).GetHtml()
        </div>
    </div>
}
<div class="dg-row" style="margin-top:30px;">
    <div class="dg-col-12">
        <a id="template-dl-forecastData" href="#">Download Forecast Data Template</a>
    </div>
</div>
<div class="dg-row" style="margin-top:30px;">
    <div class="dg-col-12" style="color:red;">
        <b>Note</b>: 
        <ol>
            <li>The file must be a valid Excel file.</li>
            <li>The "Period" Date must be formatted as MM/DD/YYYY and should always represent the first day of each month, as the forecast data is structured on a monthly basis.</li>
            <li>Do not change the header column name.if you change it, it may break the import functionality.</li>
            <li>Use cell B2 to declare the year for whatever year data it is.</li>
            <li>Strategy will only be applicable for the first month.</li>
        </ol>
    </div>
</div>



