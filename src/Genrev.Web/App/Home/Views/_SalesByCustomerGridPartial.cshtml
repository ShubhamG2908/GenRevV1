@using System.Web.UI.WebControls  
@using System.Drawing  

@Html.DevExpress().GridView(settings =>
{
    settings.Name = "SalesByCustomerGrid";
    settings.KeyFieldName = "CustomerID";
    settings.CallbackRouteValues = new { Controller = "Home", Action = "SalesByCustomerGridCallback" };
    settings.Width = Unit.Percentage(100);

    settings.SettingsPager.Visible = true;
    settings.SettingsPager.Position = PagerPosition.Bottom;
    settings.SettingsPager.FirstPageButton.Visible = true;
    settings.SettingsPager.LastPageButton.Visible = true;
    settings.SettingsPager.PageSizeItemSettings.Visible = true;
    settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "10", "20", "30", "50", "100" };

    settings.SettingsBehavior.AllowSort = true;

    settings.Styles.Header.HorizontalAlign = HorizontalAlign.Center;

    settings.Columns.Add(c =>
    {
        c.FieldName = "CustomerName";
        c.Caption = "Customer";
        c.Width = Unit.Percentage(25);
    });

    settings.Columns.Add(c =>
    {
        c.FieldName = "YTDActual";
        c.Caption = "Year-to-Date Actual";
        c.PropertiesEdit.DisplayFormatString = "C0";
        c.Width = Unit.Percentage(25);
    });

    settings.Columns.Add(c =>
    {
        c.FieldName = "YTDForecast";
        c.Caption = "Year-to-Date Forecast";
        c.PropertiesEdit.DisplayFormatString = "C0";
        c.Width = Unit.Percentage(25);
    });

    settings.Columns.Add(c =>
    {
        c.FieldName = "YTDDifference";
        c.Caption = "Difference";
        c.PropertiesEdit.DisplayFormatString = "C0";
        c.Width = Unit.Percentage(25);
    });
    settings.Settings.ShowFooter = true;
    settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "YTDActual").DisplayFormat = "{0:C0}";
    settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "YTDForecast").DisplayFormat = "{0:C0}";
    settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "YTDDifference").DisplayFormat = "{0:C0}";

    settings.HtmlDataCellPrepared = (sender, e) =>
    {
        if (e.DataColumn.FieldName == "YTDDifference")
        {
            decimal cellValue;
            string cellText = e.CellValue != null ? e.CellValue.ToString() : string.Empty;
            if (decimal.TryParse(cellText, out cellValue))
            {
                e.Cell.ForeColor = cellValue < 0 ? Color.Red : Color.Black;
            }
        }
    };
    settings.HtmlFooterCellPrepared = (sender, e) =>
    {
        var column = e.Column as DevExpress.Web.GridViewDataColumn;
        if (column == null)
            return;

        var grid = e.Column.Grid;

        foreach (DevExpress.Web.ASPxSummaryItem summaryItem in grid.TotalSummary)
        {
            if (summaryItem.FieldName == column.FieldName)
            {
                object value = e.GetSummaryValue(summaryItem);
                if (value != null)
                {
                    decimal summaryValue;
                    if (decimal.TryParse(value.ToString(), out summaryValue))
                    {
                        e.Cell.ForeColor = summaryValue < 0 ? Color.Red : Color.Black;
                    }
                }
                break;
            }
        }
    };
    settings.ClientSideEvents.EndCallback = "onSalesByCustomerSalespersonGridEndCallback";
}).Bind(Model).GetHtml()


