<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8" />
    <title>GENREV!</title>

    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet">

    <link href="@Url.Content("~/Client/Css/app-v10.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Client/Css/sprites-v1.css")" rel="stylesheet" type="text/css" />

    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
        new StyleSheet { ExtensionSuite = ExtensionSuite.Editors },
        new StyleSheet { ExtensionSuite = ExtensionSuite.GridView }
    )

    @Html.DevExpress().GetScripts(
        new Script { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
        new Script { ExtensionSuite = ExtensionSuite.GridView },
        new Script { ExtensionSuite = ExtensionSuite.Editors }
    )

    <script type="text/javascript" src="~/client/scripts/require.v2.2.0.js"></script>
    <script src="~/client/scripts/lib/textEditor/tinymce.min.js"></script>
    <script>
        function adjustGridHeight() {
            var grid = document.getElementById("CRMGrid");
            if (grid) {
                var rowCount = grid.querySelectorAll(".dxgvDataRow").length;
                var rowHeight = 40; // Approximate row height in pixels
                var headerHeight = 50; // Approximate header height in pixels
                var pagerHeight = 50; // Approximate pager height in pixels
                grid.style.height = (rowCount * rowHeight + headerHeight + pagerHeight) + "px";
            }
        }

        // Call adjustGridHeight on page load
        document.addEventListener("DOMContentLoaded", adjustGridHeight);
    </script>
    <script>
        $("#crmForm").submit(function () {
            // Collect phone numbers
            var phoneNumbers = [];
            $("#phoneContainer input").each(function () {
                phoneNumbers.push($(this).val());
            });
            $("<input>").attr({ type: "hidden", name: "Phones", value: JSON.stringify(phoneNumbers) }).appendTo("#crmForm");

            // Collect email addresses
            var emailAddresses = [];
            $("#emailContainer input").each(function () {
                emailAddresses.push($(this).val());
            });
            $("<input>").attr({ type: "hidden", name: "Emails", value: JSON.stringify(emailAddresses) }).appendTo("#crmForm");

            // Collect addresses
            var addresses = [];
            $("#addressContainer .field-group").each(function () {
                var address = {
                    Line1: $(this).find("input[name*='Line1']").val(),
                    Line2: $(this).find("input[name*='Line2']").val(),
                    City: $(this).find("input[name*='City']").val(),
                    State: $(this).find("input[name*='State']").val(),
                    Pincode: $(this).find("input[name*='Pincode']").val(),
                    Country: $(this).find("input[name*='Country']").val()
                };
                addresses.push(address);
            });

            $("<input>").attr({ type: "hidden", name: "Addresses", value: JSON.stringify(addresses) }).appendTo("#crmForm");
        });
    </script>

    <script>
    $(document).ready(function () {
        var selectedSalesPersonId = '@ViewBag.SelectedSalesPersonId';
     window.GenrevCurrency = '@Html.Raw(Session["GenRevCountryCode"] != null ? Session["GenRevCountryCode"].ToString() : "$")';

    if (selectedSalesPersonId) {
        loadCustomers(selectedSalesPersonId);
    }
});

function onSalesPersonChange(s, e) {
    var selectedSalesPersonId = s.GetValue();
    loadCustomers(selectedSalesPersonId);
    }
function loadCustomers(salesPersonId) {
    $.ajax({
        url: '@Url.Action("GetCustomersBySalesPerson", "CRM")',
        type: 'GET',
        data: { salesPersonId: salesPersonId },
        success: function (data) {
            var customerDropdown = ASPxClientComboBox.Cast("CustomerId");
            customerDropdown.ClearItems();

            $.each(data, function (index, item) {
                customerDropdown.AddItem(Text = item.Name, Value = item.ID);
            });

            customerDropdown.SetSelectedIndex(0);
        }
    });
        }
function onCustomerChange(s, e) {
    var selectedCustomerId = s.GetValue();
    fetchStrategy(selectedCustomerId);
        }
    function fetchStrategy(customerId) {
    $.ajax({
        url: '@Url.Action("GetStrategyByCustomer", "CRM")',
        type: 'GET',
        data: { customerId: customerId },
        success: function (response) {
            $("[name='Strategy']").val(response.strategy);
        },
        error: function () {
            console.error("Error fetching strategy.");
        }
    });
}
    </script>
    <script type="text/javascript">

        function EnsureAppLoaded(callback) {

            // to make sure we don't load in tandem via content page and root page
            if (window.AppLoading == true) {
                return;
            }

            // the content page may request this so root may have already loaded it
            // if so, run a callback if one was supplied
            if (window.AppLoaded == true) {
                if (App.IsCallback(callback)) {
                    callback();
                }
                return;
            }

            // we're loading...
            window.AppLoading = true;

            // initialize the app
            require(['/client/scripts/config.v1.11.js'], function () {

                require([
                    'genrev',
                    'userShell',
                    'charts',
                    'highcharts',
                    'devex',
                    'core',
                    'deepmerge',
                    'history'
                ], function () {


                    require(['highchartsnodata'], function () {


                        App.Initialize();

                        Shell.Initialize(function () {

                            Genrev.ViewAs.Init();

                            // flag that the app is initialized
                            window.AppLoaded = true;
                            window.AppLoading = false;

                            // run the callback if we were provided with one
                            if (App.IsCallback(callback)) {
                                callback();
                            }

                        }); // end shell.Initialize

                    })


                }); // end require.userShell|DevEx|Core|History

            }); // end require.Config

        }   // end EnsureAppLoaded

    </script>
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            var crmLink = document.querySelector('a[href="/CRM"]');
            if (crmLink) {
                crmLink.addEventListener("click", function (event) {
                    event.preventDefault();
                    window.location.href = "/CRM";
                });
            }
        });
    </script>
</head>
<body>
    @Html.DevExpress().Splitter(settings => {
    settings.Name = "MainSplitter";
    settings.AllowResize = false;
    settings.Orientation = Orientation.Vertical;
    settings.FullscreenMode = true;
    settings.SeparatorVisible = false;
    settings.Styles.Pane.Border.BorderWidth = Unit.Pixel(0);
    settings.Styles.Pane.Paddings.Padding = Unit.Pixel(0);

    settings.Panes.Add(pane => {
        pane.Name = "Header";
        pane.AutoHeight = true;
        pane.MinSize = Unit.Pixel(100);
        pane.PaneStyle.BorderBottom.BorderWidth = Unit.Pixel(1);
        pane.PaneStyle.CssClass = "headerPane";
        pane.SetContent(() => {
            Html.RenderPartial("HeaderPartialView");
        });
    });

    settings.Panes.Add(pane => {
        pane.Name = "Content";
        pane.PaneStyle.CssClass = "mainContentPane";
        pane.MinSize = Unit.Pixel(375);
        pane.PaneStyle.BackColor = System.Drawing.Color.White;
        pane.PaneStyle.BorderBottom.BorderWidth = Unit.Pixel(1);
        pane.SetContent(RenderBody().ToHtmlString());
    });

    settings.Panes.Add(pane => {
        pane.Name = "Footer";
        pane.Size = Unit.Pixel(25);
        pane.PaneStyle.CssClass = "footerPane";
        pane.SetContent(() => {
            Html.RenderPartial("FooterPartialView");
        });
    });
}).GetHtml()
    @if (User.Identity.IsAuthenticated) {
        
        <div id="hidden-component-containers">
            <div id="memberbar-user-popup-container"></div>
            <div id="memberbar-feedback-popup-container"></div>
            <div id="memberbar-viewas-popup-container"></div>

            <div id="app-search-popup-container"></div>

            <div id="app-dialog-alert-popup-container"></div>
            <div id="app-dialog-confirm-popup-container"></div>

        </div>

        <script>EnsureAppLoaded();</script>

    } else {

        @*<script>
        // initialize core modules
        require(['client/scripts/config.v1.4'], function () {
            require(['core'], function () {
                App.Initialize();
            });
        });
        </script>*@

    }

</body>
</html>